rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getRole() {
      return request.auth.token.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && (getRole() == 'admin' || request.auth.token.email == 'admin@smartmess.edu');
    }
    
    function isManager() {
      return isAuthenticated() && (getRole() == 'manager' || request.auth.token.email == 'manager@smartmess.edu' || request.auth.token.email == '6200432942@smartmess.edu');
    }
    
    function isStudent() {
      return isAuthenticated() && getRole() == 'student';
    }
    
    function isManagerOrAdmin() {
      return isManager() || isAdmin();
    }
    
    function ownsDoc(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function sameMessAsManager(messId) {
      return isManager() && request.auth.token.messId == messId;
    }
    
    function studentBelongsToMess(messId) {
      return isStudent() && request.auth.token.messId == messId;
    }
    
    function isActive() {
      return request.auth.token.status == 'active';
    }
    
    // USERS collection - identity + role
    match /users/{uid} {
      allow read: if ownsDoc(uid) || isAdmin();
      allow create: if isAdmin(); // Only admin creates users
      allow update: if isAdmin() && 
        // Protect critical fields from admin-side bugs
        request.resource.data.keys().hasAll(['name', 'email', 'role', 'status']);
      allow delete: if isAdmin();
    }
    
    // STUDENTS collection
    match /students/{studentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }
    
    // MANAGERS collection
    match /managers/{managerId} {
      allow read: if (isManager() && request.auth.token.managerId == managerId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // MESSES collection
    match /messes/{messId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || sameMessAsManager(messId);
      allow delete: if isAdmin();
    }
    
    // HOSTELS collection
    match /hostels/{hostelId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // MEALS collection
    match /meals/{mealId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin();
      allow update: if isManagerOrAdmin() && sameMessAsManager(resource.data.messId);
      allow delete: if isAdmin();
    }
    
    // MESS-OFFS collection
    match /messOffs/{messOffId} {
      allow read: if (isStudent() && resource.data.studentId == request.auth.token.studentId) ||
                     (isManager() && resource.data.messId == request.auth.token.messId) ||
                     isAdmin();
      // Students create via Cloud Function only (enforces deadline etc.)
      allow create: if false; // Cloud Function only
      allow update: if false; // Cloud Function only  
      allow delete: if false; // Immutable
    }
    
    // MEAL ATTENDANCE collection
    match /mealAttendance/{attendanceId} {
      allow read: if (isStudent() && resource.data.studentId == request.auth.token.studentId) ||
                     (isManager() && resource.data.messId == request.auth.token.messId) ||
                     isAdmin();
      allow create: if false; // Cloud Function only
      allow update: if false; // Cloud Function only
      allow delete: if false;
    }
    
    // PREDICTIONS collection
    match /predictions/{predictionId} {
      allow read: if isManagerOrAdmin();
      allow create: if false; // Cloud Function only
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    // FOOD PREPARATION collection
    match /foodPreparation/{prepId} {
      allow read: if isManagerOrAdmin();
      allow create: if false; // Cloud Function only
      allow update: if false; // Cloud Function only
      allow delete: if isAdmin();
    }
    
    // WASTAGE collection
    match /wastage/{wastageId} {
      allow read: if isManagerOrAdmin();
      allow create: if false; // Cloud Function only
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    // COMPLAINTS collection
    match /complaints/{complaintId} {
      allow read: if (isStudent() && resource.data.studentId == request.auth.token.studentId) ||
                     (isManager() && resource.data.messId == request.auth.token.messId) ||
                     isAdmin();
      allow create: if isStudent() && isActive() &&
                       request.resource.data.studentId == request.auth.token.studentId &&
                       request.resource.data.keys().hasAll(['studentId', 'messId', 'category', 'description', 'status', 'createdAt']) &&
                       request.resource.data.status == 'pending' &&
                       !request.resource.data.keys().hasAny(['managerResponse', 'resolvedAt']);
      allow update: if (isManager() && resource.data.messId == request.auth.token.messId &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'managerResponse', 'resolvedAt', 'updatedAt'])) ||
                       isAdmin();
      allow delete: if isAdmin();
    }
    
    // NOTIFICATIONS collection
    match /notifications/{notificationId} {
      allow read: if (isStudent() && resource.data.recipientUid == request.auth.uid) ||
                     isManagerOrAdmin();
      allow create: if false; // Cloud Function only
      allow update: if ownsDoc(resource.data.recipientUid) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if false;
    }
    
    // EVENTS collection (exams, holidays, events)
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin();
      allow update: if isManagerOrAdmin();
      allow delete: if isManagerOrAdmin();
    }
    
    // BILLS collection
    match /bills/{billId} {
      allow read: if (isStudent() && resource.data.studentId == request.auth.token.studentId) ||
                     (isManager() && resource.data.messId == request.auth.token.messId) ||
                     isAdmin();
      allow create: if false; // Cloud Function only
      allow update: if false; // Cloud Function only
      allow delete: if isAdmin();
    }
    
    // AUDIT LOGS - append only, never modifiable
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if false; // Cloud Function only (Admin SDK bypasses rules)
      allow update: if false;
      allow delete: if false;
    }
    
    // FCM DEVICE TOKENS
    match /devices/{uid}/tokens/{tokenId} {
      allow read: if ownsDoc(uid) || isAdmin();
      allow create: if ownsDoc(uid);
      allow update: if ownsDoc(uid);
      allow delete: if ownsDoc(uid) || isAdmin();
    }
    
    // QR SESSIONS (short-lived, manager creates)
    match /qrSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin();
      allow update: if false; // Cloud Function only
      allow delete: if isManagerOrAdmin();
    }
  }
}
